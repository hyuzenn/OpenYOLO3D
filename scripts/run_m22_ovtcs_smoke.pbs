#!/bin/bash
#PBS -N m22_ovtcs_smoke
#PBS -q coss_agpu
#PBS -l select=1:ncpus=8:ngpus=1:mem=64gb:Qlist=agpu
#PBS -l walltime=04:00:00
#PBS -j oe

# OV-TCS-aware EMA — minimal 2-arm smoke (M22, ScanNet200).
#   M22_base_weighted : w = alpha*c            (confidence-only control)
#   M22_ovtcs_scale   : w = alpha*c*OVTCS_C    (OV-TCS-aware)
# Deterministic first-10-scene subset. Gate before any larger run.

PROJECT_ROOT=/home/rintern16/OpenYOLO3D
cd "$PROJECT_ROOT"

CACHE_DIR="${PROJECT_ROOT}/results/2026-05-13_mask3d_cache"
DATE=$(date +%F)
EXP=scannet_m22_ovtcs_smoke
N=$(printf '%02d' $(($(ls -d "results/${DATE}_${EXP}_v"* 2>/dev/null | wc -l) + 1)))
RUN_DIR="${PROJECT_ROOT}/results/${DATE}_${EXP}_v${N}"
export RUN_DIR
mkdir -p "$RUN_DIR"
cp pretrained/config_scannet200.yaml "$RUN_DIR/config.yaml"

LOG="$RUN_DIR/run.log"
exec >"$LOG" 2>&1

echo "=== Run directory: $RUN_DIR ==="
echo "=== M22 OV-TCS-aware EMA smoke: baseline vs ovtcs_scale ==="
echo "=== Axes: M22_base_weighted M22_ovtcs_scale | scenes: first 10 ==="
echo "=== Date: $(date) ==="

source /home/rintern16/miniconda3/etc/profile.d/conda.sh
conda activate openyolo3d
export CUDA_HOME=/tools/cuda/cuda11.7
export PATH=$CUDA_HOME/bin:$PATH
export LD_LIBRARY_PATH=$CUDA_HOME/lib64:$LD_LIBRARY_PATH
# yolo_world (2D net) is an editable install whose finder hook does not resolve
# under batch — add the package dir to PYTHONPATH like run_hybrid_v2_eval.pbs.
export PYTHONPATH="${PROJECT_ROOT}:${PROJECT_ROOT}/models/YOLO-World:${PYTHONPATH:-}"

python -m method_scannet.streaming.eval_streaming_ablation \
  --cache-dir "$CACHE_DIR" \
  --output "$RUN_DIR" \
  --config pretrained/config_scannet200.yaml \
  --axes M22_base_weighted M22_ovtcs_scale \
  --limit 10

EXIT=$?
echo "=== exit code: $EXIT ==="

# CPU-only aggregation (writes notes.md comparison table)
python scripts/aggregate_m22_ovtcs.py --run-dir "$RUN_DIR" || true

echo "=== done: $(date) ==="
exit $EXIT
