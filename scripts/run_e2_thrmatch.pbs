#!/bin/bash
#PBS -q coss_agpu
#PBS -l select=1:ncpus=8:ngpus=1:mem=64gb:Qlist=agpu
#PBS -l walltime=08:00:00
#PBS -j oe
# E2: score-threshold-matched control for the temporal layer (M11 gate, N=3).
#
# Reviewer claim: "the temporal layer only raises precision by emitting fewer
# boxes." Control: the same baseline detector, thresholded to the SAME emitted
# box count as the gated arm, with the same association frame / GT / evaluator.
# Baseline and gate arms are reused frozen from results/2026-07-18_e1_grid_v01.
#
# Submit:  qsub scripts/run_e2_thrmatch.pbs

PROJECT_ROOT=/home/rintern16/OpenYOLO3D
cd "$PROJECT_ROOT"
source /home/rintern16/miniconda3/etc/profile.d/conda.sh
conda activate openyolo3d-dev
export CUDA_HOME=/tools/cuda/cuda11.7
export PATH=$CUDA_HOME/bin:$PATH
export LD_LIBRARY_PATH=$CUDA_HOME/lib64:$LD_LIBRARY_PATH

GRID="$PROJECT_ROOT/results/2026-07-18_e1_grid_v01/cells"
CACHE_GAMMA="$PROJECT_ROOT/results/outdoor_native_temporal_cpcache_thr000_single_gravity"
DATE=$(date +%F)
EXP=e2_thrmatch
N=$(printf '%02d' $(($(ls -d results/${DATE}_${EXP}_v* 2>/dev/null | wc -l) + 1)))
RUN_DIR="${RUN_DIR:-$PROJECT_ROOT/results/${DATE}_${EXP}_v${N}}"
mkdir -p "$RUN_DIR/cells"
exec >"$RUN_DIR/run.log" 2>&1

BASE_TRACKS="$GRID/gamma_ego/axis_baseline/tracks.json"   # emission is assoc-independent
echo "== E2 threshold-matched control  $(date)  host=$(hostname)  run_dir=$RUN_DIR"

# frame|gate cell|control cell
ARMS=("ego|gamma_ego_p1|ctrl_ego" "global|gamma_global_p1|ctrl_global")

for arm in "${ARMS[@]}"; do
  IFS='|' read -r FRAME GATE CTRL <<< "$arm"
  TARGET=$(python -c "
import json,glob
p=glob.glob('$GRID/$GATE/axis_*/metrics.json')[0]
print(json.load(open(p))['n_pred_boxes_total'])")
  echo "== [$CTRL] frame=$FRAME target=$TARGET (from $GATE)  $(date)"

  TJ="$RUN_DIR/threshold_${FRAME}.json"
  python -u scripts/e2_thrmatch_pick.py --tracks "$BASE_TRACKS" \
      --target "$TARGET" --out "$TJ" || { echo "== [$CTRL] PICK FAILED"; continue; }
  THR=$(python -c "import json;print(json.load(open('$TJ'))['threshold'])")

  CELL="$RUN_DIR/cells/$CTRL"
  echo "== [$CTRL] replay with --proposal-score-threshold $THR  $(date)"
  python -u -m method_scannet.streaming.nuscenes_native_evaluator \
    --output "$CELL" --axes baseline \
    --proposal-source gamma --association-frame "$FRAME" \
    --cp-cache-dir "$CACHE_GAMMA" --no-gpu --collect-track-metrics \
    --proposal-score-threshold "$THR" \
    || { echo "== [$CTRL] REPLAY FAILED"; continue; }

  # count-match audit: emitted boxes must land within +-1% of the gated arm
  python -c "
import json,glob,sys
m=json.load(open(glob.glob('$CELL/axis_*/metrics.json')[0]))
n,t=m['n_pred_boxes_total'],$TARGET
print(f'== [$CTRL] MATCH emitted={n} target={t} rel_err={(n-t)/t:+.4%}')
sys.exit(0 if abs(n-t)/t<=0.01 else 3)" || echo "== [$CTRL] WARNING count match outside +-1%"

  echo "== [$CTRL] gt metrics  $(date)"
  python -u scripts/e1_gt_metrics.py --cell "$CELL" || echo "== [$CTRL] GT METRICS FAILED"
done

echo "== E2 report  $(date)"
python -u scripts/e2_thrmatch_report.py --run-dir "$RUN_DIR" --grid "$GRID" \
  || echo "== REPORT FAILED"
echo "== E2 done  $(date)"
