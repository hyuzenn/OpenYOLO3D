#!/bin/bash
#PBS -q coss_agpu
#PBS -l select=1:ncpus=8:ngpus=1:mem=64gb:Qlist=agpu
#PBS -l walltime=08:00:00
#PBS -j oe
#PBS -N e4_sens

# E4 associator sensitivity sweep — cache replay only (--no-gpu).
# Env: CHUNK=0..4 (stride-5 slice of the 30-run grid) | SMOKE=1 (3 default runs,
# --scene-limit 2). Idempotent: a run is skipped if its metrics.json exists.

PROJECT_ROOT=/home/rintern16/OpenYOLO3D/.claude/worktrees/e4-assoc-sensitivity
MAIN=/home/rintern16/OpenYOLO3D
cd "$PROJECT_ROOT"

OUT_ROOT="$PROJECT_ROOT/results/e4_associator_sensitivity"
SMOKE="${SMOKE:-0}"
CHUNK="${CHUNK:-0}"
if [ "$SMOKE" = "1" ]; then
  RUNS_DIR="$OUT_ROOT/smoke"
else
  RUNS_DIR="$OUT_ROOT/runs"
fi
mkdir -p "$RUNS_DIR"
LOG="$RUNS_DIR/job_chunk${CHUNK}_smoke${SMOKE}.log"
exec >"$LOG" 2>&1
echo "=== $(date) host=$(hostname) CHUNK=$CHUNK SMOKE=$SMOKE ==="

source /home/rintern16/miniconda3/etc/profile.d/conda.sh
conda activate openyolo3d-dev
export CUDA_HOME=/tools/cuda/cuda11.7
export PATH=$CUDA_HOME/bin:$PATH
export LD_LIBRARY_PATH=$CUDA_HOME/lib64:$LD_LIBRARY_PATH
export PYTHONPATH="${PROJECT_ROOT}:${PROJECT_ROOT}/models/YOLO-World:${PYTHONPATH:-}"

GAMMA_CACHE="$MAIN/results/outdoor_native_temporal_cpcache_thr000_single_gravity"
FUSION_CACHE="$MAIN/results/2026-06-24_outdoor_labelfusion_classaware_v01/caches/variant_G"

cfg_flags() {  # $1 = ego|global|fusion
  case "$1" in
    ego)    echo "--cp-cache-dir $GAMMA_CACHE --proposal-source gamma --association-frame ego" ;;
    global) echo "--cp-cache-dir $GAMMA_CACHE --proposal-source gamma --association-frame global" ;;
    fusion) echo "--cp-cache-dir $FUSION_CACHE --proposal-source hybrid --association-frame ego" ;;
  esac
}

# OAT grid around default d=2.0 a=5 p=0.0 (10 settings x 3 configs = 30 runs)
SETTINGS=(
  "2.0 5 0.0"
  "1.0 5 0.0" "1.5 5 0.0" "3.0 5 0.0" "4.0 5 0.0"
  "2.0 1 0.0" "2.0 3 0.0" "2.0 10 0.0"
  "2.0 5 0.1" "2.0 5 0.3"
)
CONFIGS=(ego global fusion)

RUNS=()
for s in "${SETTINGS[@]}"; do
  for c in "${CONFIGS[@]}"; do
    RUNS+=("$c $s")
  done
done

run_one() {  # $1=config $2=dist $3=age $4=pst
  local name="${1}_d${2}_a${3}_p${4}"
  local out="$RUNS_DIR/$name"
  if [ -f "$out/axis_baseline/metrics.json" ]; then
    echo "--- skip $name (metrics.json exists)"; return 0
  fi
  echo "--- run $name start $(date '+%H:%M:%S')"
  local extra=""
  [ "$SMOKE" = "1" ] && extra="--scene-limit 2"
  # shellcheck disable=SC2046
  python -u -m method_scannet.streaming.nuscenes_native_evaluator \
    --output "$out" --axes baseline \
    $(cfg_flags "$1") \
    --association-class-agnostic --no-gpu --collect-track-metrics \
    --association-threshold-m "$2" --association-max-age "$3" \
    --proposal-score-threshold "$4" $extra
  echo "--- run $name exit=$? $(date '+%H:%M:%S')"
}

if [ "$SMOKE" = "1" ]; then
  for c in "${CONFIGS[@]}"; do run_one "$c" 2.0 5 0.0; done
else
  n=${#RUNS[@]}
  for ((i=CHUNK; i<n; i+=5)); do
    # shellcheck disable=SC2086
    run_one ${RUNS[$i]}
  done
fi
echo "=== done $(date) ==="
