\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Per-scene OV-TCS vs.\ GT-based MOT metrics (nuScenes val, 150 scenes per arm). OV-TCS, computed without any ground-truth identities, tracks the association-quality axis (HOTA/AssA/IDF1) and not the detection axis.}}{5}{figure.3}}
\newlabel{fig:mot}{{3}{5}{Per-scene OV-TCS vs.\ GT-based MOT metrics (nuScenes val, 150 scenes per arm). OV-TCS, computed without any ground-truth identities, tracks the association-quality axis (HOTA/AssA/IDF1) and not the detection axis}{figure.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Associator-sensitivity sweep (30 full val150 replays): association gate $\in \{1,1.5,2,3,4\}$\tmspace  +\thinmuskip {.1667em}m, max-age $\in \{1,3,5,10\}$, score threshold $\in \{0,0.1,0.3\}$, one-at-a-time around the production point. Method orderings never flip. Grid-level Spearman(mAP, $\mathrm  {OV\text  {-}TCS}$) $=-0.018$: the two metrics respond to disjoint parameter axes.}}{5}{table.3}}
\newlabel{tab:sensitivity}{{3}{5}{Associator-sensitivity sweep (30 full val150 replays): association gate $\in \{1,1.5,2,3,4\}$\,m, max-age $\in \{1,3,5,10\}$, score threshold $\in \{0,0.1,0.3\}$, one-at-a-time around the production point. Method orderings never flip. Grid-level Spearman(mAP, $\ovtcs $) $=-0.018$: the two metrics respond to disjoint parameter axes}{table.3}{}}
